# Copy to backend/.env and fill in. This file is safe to commit; .env is not.
SEATS_AERO_KEY=

# Cash fares come from Google Flights directly. No key is necessary.
# To use the paid SerpApi source, set CASH_SOURCE=serpapi and SERPAPI_KEY.
# CASH_SOURCE=google
# SERPAPI_KEY=

# Set a password if other devices can reach this computer (for example on Tailscale).
# APP_PASSWORD=
